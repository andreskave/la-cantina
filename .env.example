# Copiá este archivo a .env.local y completá con los datos del proyecto de Supabase
# (Project Settings → API). La anon key es pública: la seguridad la da la RLS.
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# Solo para los scripts de /scripts (crear administrador, usuarios, seed). NUNCA en el frontend.
SUPABASE_SERVICE_ROLE_KEY=
